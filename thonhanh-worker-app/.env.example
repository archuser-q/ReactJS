# Copy thành .env khi cần đổi cấu hình (không bắt buộc).

# --- Chạy bằng Docker ---
# Cổng bản web của app thợ
WORKER_WEB_PORT=8082
# Địa chỉ API cho bản web Docker. Để trống = tự gọi http://<máy đang mở web>:3000/api
API_URL=
# IP LAN của máy tính, dùng cho "docker compose --profile dev up worker-dev" (Expo Go trên điện thoại)
HOST_IP=

# Địa chỉ backend Node.js của nhóm (tuỳ chọn).
# Bỏ trống: app tự dùng IP của máy đang chạy Expo (cổng 3000) — chạy backend cùng máy là được, không cần sửa gì.
# Điện thoại thật: dùng IP LAN của máy chạy backend.   Android emulator: http://10.0.2.2:3000/api
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api

# Tổng đài / email hỗ trợ đối tác hiển thị trong app (để trống = ẩn nút gọi/email, chỉ còn "Báo cáo sự cố" trong app)
# EXPO_PUBLIC_SUPPORT_PHONE=1900 xxxx
# EXPO_PUBLIC_SUPPORT_EMAIL=hotro@ten-mien-cua-nhom.vn
